{
  "name": "frame-media-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform image, video and audio editor and batch converter, with local media processing.",
  "author": "David Niessen",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "desktop": "node scripts/dev-desktop.mjs",
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "vendor:media-tools": "node scripts/vendor-media-tools.mjs",
    "build:windows-shell": "node scripts/build-windows-shell.mjs",
    "sign:windows-shell": "node scripts/sign-windows-shell.mjs",
    "verify:windows-shell": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/validate-windows-shell.ps1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-ffmpeg.mjs && node scripts/prepare-youtube.mjs && node --test tests/setup/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && node scripts/prepare-assets.mjs && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "npm run build && playwright test --config playwright.electron.config.ts",
    "build:icon": "node scripts/build-icon.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource/public-sans": "^5.2.7",
    "exifr": "7.1.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "undici": "^6.29.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.frame.mediaeditor",
    "productName": "Frame",
    "artifactName": "Frame-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist/ffmpeg/**/*",
      "!node_modules/@ffmpeg/**/*",
      "!node_modules/@fontsource/**/*",
      "!node_modules/{react,react-dom,scheduler,lucide-react,fflate}/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffprobe-installer/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/generated/windows-context-menu.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "public/notices",
        "to": "notices"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "build/generated/shell-actions",
        "to": "shell-actions"
      },
      {
        "from": "build/media-tools",
        "to": "media-tools",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffmpeg.LICENSE",
          "ffmpeg.README",
          "ffmpeg.exe.LICENSE",
          "ffmpeg.exe.README",
          "yt-dlp",
          "yt-dlp.exe",
          "LICENSE",
          "THIRD_PARTY_LICENSES.txt",
          "TOOLS.txt"
        ]
      }
    ],
    "beforePack": "scripts/verify-package.cjs",
    "icon": "build/icon.png"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  },
  "homepage": "https://github.com/DavidNiessen/frame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidNiessen/frame.git"
  },
  "bugs": {
    "url": "https://github.com/DavidNiessen/frame/issues"
  }
}
