{
  "name": "frame-media-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A private, extensible video and audio editor for desktop and the web",
  "author": "David Niessen",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/public-sans": "^5.2.7",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.frame.mediaeditor",
    "productName": "Frame",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json", "!dist/ffmpeg/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.video" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo" }
  }
}
