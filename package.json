{
  "name": "frame-media-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A private, extensible video and audio editor for desktop and the web",
  "author": "David Niessen",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "desktop": "node scripts/dev-desktop.mjs",
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "vendor:media-tools": "node scripts/vendor-media-tools.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-youtube.mjs && node --test tests/setup/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && node scripts/prepare-assets.mjs && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test:desktop": "npm run build && playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource/public-sans": "^5.2.7",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "typescript": "~5.9.2",
    "undici": "^6.29.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.frame.mediaeditor",
    "productName": "Frame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist/ffmpeg/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/generated/windows-context-menu.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "public/sample.mp4",
        "to": "sample.mp4"
      },
      {
        "from": "public/notices",
        "to": "notices"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "build/generated/shell-actions",
        "to": "shell-actions"
      },
      {
        "from": "build/media-tools",
        "to": "media-tools",
        "filter": [
          "yt-dlp",
          "yt-dlp.exe",
          "LICENSE",
          "THIRD_PARTY_LICENSES.txt",
          "TOOLS.txt"
        ]
      }
    ],
    "beforePack": "scripts/verify-package.cjs",
    "icon": "build/icon.png"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  }
}
